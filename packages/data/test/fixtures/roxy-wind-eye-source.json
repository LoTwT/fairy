      "mindscapes": {
        "3": {
          "pointer": "/talent/3/desc",
          "value": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2"
        },
        "5": {
          "pointer": "/talent/5/desc",
          "value": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2"
        },
        "6": {
          "pointer": "/talent/6/desc",
          "value": "自身攻击造成的伤害无视目标15%<color=#A6C5FD>风属性伤害抗性</color>；<color=#ffffff>[特殊技：恕不远送]</color>引爆<color=#ffffff>[风眼]</color>生成巨型风旋时，主目标会被赋予<color=#ffffff>[余响]</color>效果，每间隔3秒在目标位置生成一次巨型风旋，共额外生成2次巨型风旋，重复触发时额外生成次数叠加且刷新<color=#ffffff>[余响]</color>的持续时间；巨型风旋造成的伤害倍率提升至原本的250%，造成的失衡提升20%。"
        }
      }
    },
    "en": {
      "description": {
        "pointer": "/skill/special/description/4",
        "value": {
          "desc": "Generated after <color=#FFFFFF>EX Special Attack: Kindly Rest in Peace</color> consumes <Term:1000039></Term>, and automatically detonates after 30s.\nUp to 9 <Term:1000040>Eyes of the Storm</Term> can exist at the same time. If this limit is exceeded, the earliest generated <color=#FFFFFF>Eye of the Storm</color> will automatically detonate.\nDetonates when hit by <color=#FFFFFF>Special Attack: Forgive Me for Not Seeing You Off</color>. If fewer than 3 are hit at the same time, 1 Miniature Windstorm is generated at the location of each <color=#FFFFFF>Eye of the Storm</color>, tracking enemies and dealing <color=#A6C5FD>Wind DMG</color> for 1s.\nIf 3 are hit at the same time, 1 Giant Windstorm is generated instead, dealing <color=#A6C5FD>Wind DMG</color> for 1s.\nWhen detonated by any means, an <color=#FFFFFF>Eye of the Storm</color> releases a blast, dealing 1 instance of <color=#A6C5FD>Wind DMG</color> to nearby enemies.",
          "name": "Eye of the Storm",
          "potential": []
        }
      },
