    {
      "actionId": "action:agent:1501:action:0010",
      "branchId": "agent:1501:branch:basic-4",
      "name": "普通攻击：绝对音准",
      "rowName": "一段蓄力攻击伤害倍率",
      "levelGroup": "basic",
      "skillCategory": "basic",
      "skillTargetIds": [],
      "skillTags": [],
      "source": {
        "path": "agents/1501/details.zh.json",
