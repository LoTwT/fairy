    {
      "actionId": "action:agent:1161:action:0006",
      "branchId": "agent:1161:branch:basic-2",
      "name": "普通攻击：L式轰鸣拳",
      "rowName": "一段伤害倍率",
      "levelGroup": "basic",
      "skillCategory": "basic",
