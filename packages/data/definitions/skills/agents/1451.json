    {
      "actionId": "action:agent:1451:action:0016",
      "branchId": "agent:1451:branch:chain-4",
      "name": "终结技：进击，大铠甲！",
      "rowName": "突进单次撞击伤害倍率",
      "levelGroup": "chain",
      "skillCategory": "ultimate",
