  "skin": {
    "3114210": {
      "desc": "云岿山现存最大款式的弟子服饰，既容师兄肚量，又容百味调料，头顶铁锅乃一种首创。但…刚炒完菜的锅放在头上，真的不烫吗？",
      "name": "潘引壶·食引百味"
    },
    "3114211": {
      "desc": "师哥也曾梦想成为一名伟大的厨子，但这世道里，总有想砸你锅碗瓢盆的歹人。\n——「你砸一个试试？」",
      "name": "潘引壶·馔玉烹金"
    }
  },
  "specialElementType": {},
  "strategy": [
    "05",
    "<IconMap:Icon_GeneralBuff_PhysDmg>物理属性，命破体系辅助",
    "为队友提供贯穿力"
  ],
  "talent": {
    "1": {
      "desc": "所有单位对被施加<color=#FFFFFF>[气绝]</color>效果的敌人造成伤害时，造成的伤害额外提升10%。",
      "desc2": "云岿术法外可御以太流动，内可护经络筋骨。气劲如盾，刀枪不入，这便是潘引壶硬扛攻击的奥妙所在。\n另，这招在和大叔大妈们比拼抢购超市促销商品时尤其管用。",
      "name": "气劲护体"
    },
    "2": {
      "desc": "每消耗6点<color=#FFFFFF>[破劲]</color>，潘引壶将回复4点能量，<color=#FFFFFF>[特殊技：断脉破穴手]</color>命中敌人时对敌人造成的<color=#FFFFFF>[气绝]</color>效果将提升至12秒。",
      "desc2": "「嘿嘿，贼人，动弹不得了吧！」\n「这招唤作云岿点穴手，既可痹体定身，也可打通经脉，乃我门派惩恶扬善之绝学也！」\n「…诶，你说只是因为我手劲太大，把你身子给打麻了？…你就说能不能动吧！」",
      "name": "云岿点穴手"
    },
    "3": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "「这些个穴位，跟我们熊猫希人性质差不多。」\n「又少又分散，归不进哪个具体的系统里，也没几个人真正研究过，凄凉哟。」\n「但啥时候真当了那么一回奇兵，感觉又挺不错的，不是吗？」",
      "name": "经外奇穴"
    },
    "4": {
      "desc": "<color=#FFFFFF>[终结技：满汉全席！]</color>为全队角色回复生命时，生命回复效果提升25%，持续回复效果的生命回复效果提升25%；发动<color=#FFFFFF>[终结技：满汉全席！]</color>时获得<color=#FFFFFF>[储粮]</color>效果，当队伍内任意角色损失生命值时，消耗<color=#FFFFFF>[储粮]</color>效果为其回复<color=#FFFFFF>[终结技：满汉全席！]</color>即时回复生命值50%的生命值，该效果不可叠加。",
      "desc2": "初次下厨时，他差点把灶台点着。赶来救火的人里有个厨子，看着那堆烧糊了的食物，把还没用的鸡蛋下锅给他做了盘蛋炒饭。\n他狼吞虎咽，热泪盈眶。抬起头来，只见厨子向他亮出一张纸，上面写着「100」。\n「大师，我悟了！您是想告诉我烹饪要百折不挠是吧！」「不是，我是想说吃一口100丁尼，你吃了一百多口，该付钱了。」\n从那以后，潘引壶坚持自己亲自下厨，且再也没搞砸过。这便是特级厨师的诞生过程。",
      "name": "特等上厨"
    },
    "5": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "在这诺大的新艾利都，熊猫希人的存在实属罕有。他抗拒被人以稀奇的眼神打量，也早已习惯了无人帮衬的孤独生活。\n直到拜入云岿山门下，他变得不再孤单。\n同时，直到发现不少市民愿意为了和熊猫希人合影而付费…他也变得不再抗拒被人打量。",
      "name": "「稀人」"
    },
    "6": {
      "desc": "<color=#FFFFFF>[核心被动：脉中乾坤]</color>提供的<color=#FFFFFF>[通窍]</color>将额外获得潘引壶初始攻击力6%的提升，该效果提供的贯穿力最多提升至720点。",
      "desc2": "「古人有云，气穴足有三百六十五处。其实人的活法亦是如此。」\n「喏，从这张穴位图上选一个喜欢的。」\n「它就代表了你现在的活法——在哪里，有啥用，都不重要。只要你喜欢，就够了。」\n「至于选它出来有啥用，我想想…有了。下回师兄教训贼人时，就专攻这个穴位吧。」",
      "name": "气穴论"
    }
  },
  "weaponType": {
    "5": "防护"
  }
}
