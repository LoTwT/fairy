  "talent": {
    "1": {
      "desc": "<color=#FFFFFF>[冲刺攻击]</color>或<color=#FFFFFF>[闪避反击]</color>命中敌人时，比利额外回复2.7点能量，5秒内最多触发一次。",
      "desc2": "「作为反派，你们也太老实了！」\n「就像为了配合主角登场，故意设置的固定靶一样！」",
      "name": "闪亮登场"
    },
    "2": {
      "desc": "<color=#FFFFFF>[闪避反击]</color>造成的伤害提升25%；<color=#FFFFFF>[普通攻击]</color>中的翻滚射击将被视为闪避动作，在招式发动期间获得无敌效果，并且能够触发<color=#FFFFFF>[极限闪避]</color>，翻滚射击触发<color=#FFFFFF>[极限闪避]</color>时，将自动衔接<color=#FFFFFF>[闪避反击]</color>。",
      "desc2": "「星徽骑士从来不会逃避危险，那叫做战术游走射击！」\n——星徽闪耀-交流区，会员「哦梦中的莫妮卡」留言。",
      "name": "游斗射术"
    },
    "3": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "绝不懈怠训练，绝不停止进步！这是星徽骑士倡导的精神。比利真的相信，而且真的在遵守。",
      "name": "星徽骑士的教导"
    },
    "4": {
      "desc": "<color=#FFFFFF>[强化特殊技]</color>命中敌人时，招式的暴击率随自身与目标之间的距离而提升；比利与目标距离越近，提升效果越显著，最高提升32%。",
      "desc2": "比利独创的爆破型子弹，\n在近身战时有着惊人的威力。\n不过比利改造子弹的本意，是让开枪时的演出效果更加帅气。",
      "name": "星徽-惩戒弹药"
    },
    "5": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "未知的精密元件和独特的构造设计带给了比利远超同侪的性能…和维修养护费用。",
      "name": "失落技术构造体"
