  "skin": {
    "3113510": {
      "desc": "风尘仆仆的雇佣兵本该浪迹天涯，但这里阳光温暖，恰好适合安睡。",
      "name": "波可娜·倦尾栖痕"
    }
  },
  "specialElementType": {},
  "strategy": [
    "07",
    "<IconMap:Icon_GeneralBuff_PhysDmg>物理属性，后台增伤辅助",
    "进入猎步状态提升失衡效率"
  ],
  "talent": {
    "1": {
      "desc": "对被施加<color=#FFFFFF>[困迹]</color>效果的敌人造成伤害时，自身暴击率提升10%。",
      "desc2": "「利己主义是一种本能，但其实也可以在后天习得。」\n「如何习得？」\n「多吃点亏自然就明白了。」",
      "name": "利己主义"
    },
    "2": {
      "desc": "处于<color=#FFFFFF>[核心被动：猎手本能]</color>的<color=#FFFFFF>[猎步]</color>状态时，波可娜的攻击力额外提升10%。",
      "desc2": "「一个雇佣兵最重要的素质不是忠诚，而是懂得借势而为。挑选合适的雇主，接下合适的委托，完成分内工作，绝不签长期合同。即使跳槽去对手那边，原雇主也没什么话好说。」\n「波可娜，刚才又有人来找你麻烦，被我打发走了。你怎么会得罪这么多人？」\n「是感情用事的人太多了。所以你看，他们都是一群拈不清自己斤两的失败者。」",
      "name": "借势而为"
    },
    "3": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "波可娜居住的卡车车厢门上贴着一张大纸。上面用红色的大字写着：这是我的地盘！进来要敲门！敲门！敲门！\n纸下方还贴有一张稍小的纸，上面用黑色的大字写着：凯撒，赔我的锁！10万丁尼！\n黑色的大字下还有一行歪歪扭扭的小字：我问过绳匠了，那锁2万！",
      "name": "领地意识"
    },
    "4": {
      "desc": "发动<color=#FFFFFF>[强化特殊技：噬爪·瞬步]</color>时的能量消耗降低5点。",
      "desc2": "「挑战强者有什么意思，我又不是自虐狂。对我而言知道自己稳赢的时候，才能体会真正的狩猎乐趣！」\n5分钟后。\n「这游戏的AI太弱了吧，没劲。」",
      "name": "狩猎乐趣"
    },
    "5": {
      "desc": "<color=#FFFFFF>[普通攻击]</color>、<color=#FFFFFF>[闪避]</color>、<color=#FFFFFF>[支援技]</color>、<color=#FFFFFF>[特殊技]</color>、<color=#FFFFFF>[连携技]</color> 技能等级+2",
      "desc2": "波可娜童年最早的模糊回忆，是一条温暖的大尾巴。在她刚学会爬行的时候，最喜欢玩追逐它的游戏。\n「后来呢？」\n「他们告诉我，那条尾巴就是我自己的。」\n但波可娜知道，那条尾巴不是她的。因为除了尾巴游戏，晚上它还会紧紧地包裹住她，度过每一个寒冷的夜晚。可能是空洞把它夺走了，或者是别的什么…哎，无所谓，反正她早就不玩这个游戏了。",
      "name": "尾巴游戏"
    },
    "6": {
      "desc": "<color=#FFFFFF>[特殊技：噬爪·噩梦袭影]</color>造成的伤害提升15%，重复攻击的可触发次数额外提升2次；<color=#FFFFFF>[额外能力：业务搭档]</color>中<color=#FFFFFF>[困迹]</color>的效果对<color=#FFFFFF>[追加攻击]</color>以外的伤害类型也会生效。",
      "desc2": "覆面式呼吸过滤器挡住了以太粒子和花粉，阻隔了或好奇或畏惧或不怀好意的视线，却让人再也没办法蜷缩起来舒服地睡个好觉了。好想去一个温暖的地方，毫无防备地睡一个午觉…\n车厢的门被毫无征兆地推开了，从梦中惊醒的她立刻抓起老搭档扣在脸上，「你们能不能学会敲门？！」\n…啊，原来现在她已经可以摘掉它了。",
      "name": "面具之下"
    }
  },
  "weaponType": {
    "2": "击破"
  }
}
