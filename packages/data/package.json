{
  "name": "@randomplay/data",
  "version": "0.2.1",
  "description": "Versioned game data for Fairy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/fairy.git",
    "directory": "packages/data"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.mjs"
    },
    "./definitions/effects/automatic.json": "./dist/definitions/effects/automatic.json",
    "./definitions/effects/starter.json": "./dist/definitions/effects/starter.json",
    "./definitions/attributes/agents/*.json": "./dist/definitions/attributes/agents/*.json",
    "./definitions/attributes/w-engines/*.json": "./dist/definitions/attributes/w-engines/*.json",
    "./definitions/attributes/drive-disc-affixes.json": "./dist/definitions/attributes/drive-disc-affixes.json",
    "./definitions/attributes/manifest.json": "./dist/definitions/attributes/manifest.json",
    "./definitions/skills/agents/*.json": "./dist/definitions/skills/agents/*.json",
    "./definitions/skills/manifest.json": "./dist/definitions/skills/manifest.json",
    "./integrated/index.json": "./dist/integrated/index.json",
    "./integrated/agents/*/data.json": "./dist/integrated/agents/*/data.json",
    "./integrated/agents/*/details.zh.json": "./dist/integrated/agents/*/details.zh.json",
    "./integrated/agents/*/details.en.json": "./dist/integrated/agents/*/details.en.json",
    "./integrated/drive-discs/*/data.json": "./dist/integrated/drive-discs/*/data.json",
    "./integrated/drive-discs/*/details.zh.json": "./dist/integrated/drive-discs/*/details.zh.json",
    "./integrated/drive-discs/*/details.en.json": "./dist/integrated/drive-discs/*/details.en.json",
    "./integrated/w-engines/*/data.json": "./dist/integrated/w-engines/*/data.json",
    "./integrated/w-engines/*/details.zh.json": "./dist/integrated/w-engines/*/details.zh.json",
    "./integrated/w-engines/*/details.en.json": "./dist/integrated/w-engines/*/details.en.json",
    "./integrated/bangboos/*/data.json": "./dist/integrated/bangboos/*/data.json",
    "./integrated/bangboos/*/details.zh.json": "./dist/integrated/bangboos/*/details.zh.json",
    "./integrated/bangboos/*/details.en.json": "./dist/integrated/bangboos/*/details.en.json",
    "./integrated/monsters/*/data.json": "./dist/integrated/monsters/*/data.json",
    "./integrated/monsters/*/details.zh.json": "./dist/integrated/monsters/*/details.zh.json",
    "./integrated/monsters/*/details.en.json": "./dist/integrated/monsters/*/details.en.json",
    "./integrated/shiyu/*/data.json": "./dist/integrated/shiyu/*/data.json",
    "./integrated/shiyu/*/details.zh.json": "./dist/integrated/shiyu/*/details.zh.json",
    "./integrated/shiyu/*/details.en.json": "./dist/integrated/shiyu/*/details.en.json",
    "./integrated/boss/*/data.json": "./dist/integrated/boss/*/data.json",
    "./integrated/boss/*/details.zh.json": "./dist/integrated/boss/*/details.zh.json",
    "./integrated/boss/*/details.en.json": "./dist/integrated/boss/*/details.en.json",
    "./integrated/simul/*/data.json": "./dist/integrated/simul/*/data.json",
    "./integrated/simul/*/details.zh.json": "./dist/integrated/simul/*/details.zh.json",
    "./integrated/simul/*/details.en.json": "./dist/integrated/simul/*/details.en.json",
    "./definitions/effects/static.json": "./dist/definitions/effects/static.json",
    "./definitions/effects/static-catalog.json": "./dist/definitions/effects/static-catalog.json",
    "./definitions/effects/static-coverage.json": "./dist/definitions/effects/static-coverage.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm prepare:consumer && pnpm typecheck:prepared && pnpm test:prepared && pnpm verify:pack",
    "fetch:nanoka": "node scripts/nanoka-source.ts fetch",
    "verify:nanoka:snapshot": "node scripts/verify-nanoka-snapshot.ts",
    "generate:integrated": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts generate",
    "verify:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts verify",
    "recover:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts recover",
    "migrate:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts migrate",
    "prepack": "pnpm build",
    "test": "pnpm prepare:consumer && pnpm test:prepared",
    "test:prepared": "vitest run --project unit --project integration",
    "test:fast": "pnpm prepare:consumer && vitest run --project unit",
    "test:integration": "pnpm prepare:consumer && vitest run --project integration",
    "test:watch": "pnpm prepare:consumer && vitest --project unit --project integration",
    "test:coverage": "pnpm prepare:consumer && vitest run --coverage --project unit --project integration",
    "typecheck": "pnpm prepare:consumer && pnpm typecheck:prepared",
    "typecheck:prepared": "tsc --noEmit",
    "verify:pack": "vitest run --project packaging test/verify-package.test.ts",
    "prepare:consumer": "node --disable-warning=ExperimentalWarning scripts/prepare-consumer-types.ts",
    "verify:browser": "vitest run --project packaging test/verify-browser.test.ts",
    "generate:static-effects": "pnpm --filter @randomplay/core build && node scripts/generate-static-effects.ts",
    "generate:panel-attributes": "node --disable-warning=ExperimentalWarning scripts/generate-panel-attributes.ts",
    "generate:agent-actions": "node --disable-warning=ExperimentalWarning scripts/generate-agent-actions.ts"
  },
  "devDependencies": {
    "@randomplay/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.63.0",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
