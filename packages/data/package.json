{
  "name": "@randomplay/data",
  "version": "0.2.0",
  "description": "Versioned game data for Fairy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/fairy.git",
    "directory": "packages/data"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.mjs"
    },
    "./integrated/index.json": "./dist/integrated/index.json",
    "./integrated/agents/*/data.json": "./dist/integrated/agents/*/data.json",
    "./integrated/agents/*/details.zh.json": "./dist/integrated/agents/*/details.zh.json",
    "./integrated/agents/*/details.en.json": "./dist/integrated/agents/*/details.en.json",
    "./integrated/drive-discs/*/data.json": "./dist/integrated/drive-discs/*/data.json",
    "./integrated/drive-discs/*/details.zh.json": "./dist/integrated/drive-discs/*/details.zh.json",
    "./integrated/drive-discs/*/details.en.json": "./dist/integrated/drive-discs/*/details.en.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm prepare:consumer && pnpm typecheck:prepared && pnpm test:prepared && pnpm verify:pack",
    "fetch:nanoka": "node scripts/nanoka-source.ts fetch",
    "verify:nanoka:snapshot": "node scripts/verify-nanoka-snapshot.ts",
    "generate:integrated": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts generate",
    "verify:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts verify",
    "recover:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts recover",
    "migrate:nanoka:current": "node --disable-warning=ExperimentalWarning scripts/current-nanoka-dataset.ts migrate",
    "prepack": "pnpm build",
    "test": "pnpm prepare:consumer && pnpm test:prepared",
    "test:prepared": "vitest run --project unit --project integration",
    "test:fast": "pnpm prepare:consumer && vitest run --project unit",
    "test:integration": "pnpm prepare:consumer && vitest run --project integration",
    "test:watch": "pnpm prepare:consumer && vitest --project unit --project integration",
    "test:coverage": "pnpm prepare:consumer && vitest run --coverage --project unit --project integration",
    "typecheck": "pnpm prepare:consumer && pnpm typecheck:prepared",
    "typecheck:prepared": "tsc --noEmit",
    "verify:pack": "vitest run --project packaging test/verify-package.test.ts",
    "prepare:consumer": "node --disable-warning=ExperimentalWarning scripts/prepare-consumer-types.ts",
    "verify:browser": "vitest run --project packaging test/verify-browser.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.63.0",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
