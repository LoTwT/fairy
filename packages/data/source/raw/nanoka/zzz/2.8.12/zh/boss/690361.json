      "selectable_buff": {
        "69012403": {
          "title": "合击",
          "desc": "· 队伍内存在1名/2名[强攻]特性的代理人时，全队造成的暴击伤害<color=#2BAD00>提升20%/60%</color>。\n· 发动[强化特殊技]、[终结技]后，代理人的<color=#2EB6FF>电属性伤害</color><color=#2BAD00>提升20%</color>，[强攻]特性代理人造成的伤害<color=#2BAD00>额外提升30%</color>，持续20秒，重复触发时刷新持续时间。"
        },
        "69013603": {
          "title": "焚霜",
          "desc": "· 代理人的异常精通<color=#2BAD00>提升30点</color>，<color=#FFFFFF>[异放]</color>造成的伤害<color=#2BAD00>提升10%</color>。\n· 对敌人施加<color=#FFFFFF>[异放]</color>效果后，敌人的<color=#98EFF0>冰属性伤害抗性</color><color=#2BAD00>降低25%</color>，代理人造成的<color=#98EFF0>冰属性伤害</color><color=#2BAD00>提升30%</color>，持续15秒，重复触发时刷新持续时间。"
        },
        "69013604": {
          "title": "破境",
          "desc": "· [命破]特性的代理人贯穿伤害<color=#2BAD00>提升15%</color>，造成的秽息盾削减值<color=#2BAD00>提升30%</color>。\n· 处于以太帷幕中的代理人，<color=#FE437E>以太属性伤害</color><color=#2BAD00>提升25%</color>，攻击命中敌人后使其失衡易伤倍率<color=#2BAD00>提升25%</color>，持续10秒，重复触发时刷新持续时间。"
        }
      }
    },
    "6903602": {
      "name": "彷徨猎手",
      "stage_num": 2,
      "monster_level": 70,
      "layer_buff": {
        "69012102": {
          "title": "",
          "desc": ""
        },
        "69012302": {
          "title": "",
          "desc": "· 彷徨猎手处于[秽浊流界]中时，基础防御提高40%；代理人发动<color=#FFAF2C>[支援突击]或[闪避反击]</color>命中彷徨猎手时，将对其施加1层<color=#FFFFFF>[动摇]</color>。<color=#FFFFFF>[动摇]</color>最多叠加5层，持续15秒，重复触发时刷新持续时间。\n· 代理人攻击命中彷徨猎手时，对方每有1层[动摇]，代理人的贯穿伤害<color=#FFAF2C>提升7%</color>。"
        },
        "69012303": {
          "title": "",
          "desc": "· 在捉迷藏阶段，使用<color=#FFAF2C>[觉感术]</color>破除<color=#FFAF2C>溺想者·卢西娅的真身</color>，可获得<color=#FFAF2C>3000操作得分</color>；破除真身后发动<color=#FFAF2C>[招架支援]或[支援突击]</color>命中彷徨猎手，化解其突袭，可获得<color=#FFAF2C>2000操作得分</color>，最多获得5000操作得分。"
        },
        "69013002": {
          "title": "",
          "desc": "· 适合<IconMap:Icon_AvatarClass_Rupture><color=#FFAF2C>[命破]</color>特性的代理人挑战。"
