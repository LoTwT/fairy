      "stage_num": 1,
      "monster_level": 70,
      "layer_buff": {
        "69012102": {
          "title": "",
          "desc": ""
        },
        "69012302": {
          "title": "",
          "desc": "· 彷徨猎手处于[秽浊流界]中时，基础防御提高40%；代理人发动<color=#FFAF2C>[支援突击]或[闪避反击]</color>命中彷徨猎手时，将对其施加1层<color=#FFFFFF>[动摇]</color>。<color=#FFFFFF>[动摇]</color>最多叠加5层，持续15秒，重复触发时刷新持续时间。\n· 代理人攻击命中彷徨猎手时，对方每有1层[动摇]，代理人的贯穿伤害<color=#FFAF2C>提升7%</color>。"
        },
        "69012303": {
          "title": "",
          "desc": "· 在捉迷藏阶段，使用<color=#FFAF2C>[觉感术]</color>破除<color=#FFAF2C>溺想者·卢西娅的真身</color>，可获得<color=#FFAF2C>3000操作得分</color>；破除真身后发动<color=#FFAF2C>[招架支援]或[支援突击]</color>命中彷徨猎手，化解其突袭，可获得<color=#FFAF2C>2000操作得分</color>，最多获得5000操作得分。"
        },
        "69013002": {
          "title": "",
          "desc": "· 适合<IconMap:Icon_AvatarClass_Rupture><color=#FFAF2C>[命破]</color>特性的代理人挑战。"
        }
      },
