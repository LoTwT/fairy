        "69012801": {
          "title": "异变",
          "desc": "· 代理人的攻击力<color=#2BAD00>提升25%</color>，异常精通<color=#2BAD00>提升40</color>点。\n· 对敌人施加属性异常效果后，敌人的全伤害抗性<color=#2BAD00>降低10%</color>，代理人对其造成的属性异常伤害<color=#2BAD00>提升30%</color>，持续15秒，重复触发时刷新持续时间。"
        },
        "69014001": {
          "title": "(Test1)TBD",
          "desc": "· 代理人造成的伤害<color=#2BAD00>提升20%</color>，暴击伤害<color=#2BAD00>提升30%</color>。\\n· <color=#FFFFFF>[强攻]</color>特性代理人攻击力<color=#2BAD00>提升10%</color>，<color=#FFFFFF>[普通攻击]</color>/<color=#FFFFFF>[终结技]</color>造成的伤害<color=#2BAD00>提升30%</color>，并无视敌人<color=#2BAD00>10%</color>的防御力。"
        },
        "69014002": {
          "title": "(Test1)TBD",
          "desc": "· 代理人造成的失衡值<color=#2BAD00>提升10%</color>，<color=#FFFFFF>[普通攻击]</color>/<color=#FFFFFF>[连携技]</color>无视敌人<color=#2BAD00>15%</color>的全属性伤害抗性。\\n· 发动<color=#FFFFFF>[连携技]</color>后，全队的暴击伤害<color=#2BAD00>提升15%</color>，持续15秒，最多可叠加4层，重复触发时刷新持续时间。"
        }
      }
