{
  "name": "zzz-agent",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "prepare:zzz-data": "pnpm -C ../.. --filter zzz-data run build",
    "dev": "pnpm run prepare:zzz-data && mastra dev",
    "test": "pnpm run prepare:zzz-data && vitest run",
    "build": "pnpm run prepare:zzz-data && mastra build",
    "start": "mastra start"
  },
  "dependencies": {
    "@mastra/core": "^1.10.0",
    "@mastra/evals": "^1.1.2",
    "@mastra/libsql": "^1.6.4",
    "@mastra/loggers": "^1.0.2",
    "@mastra/memory": "^1.6.1",
    "@mastra/observability": "^1.3.1",
    "zod": "^4.3.6",
    "zzz-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "mastra": "^1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
