{
  "name": "zzz-data",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.20.0",
  "description": "zzz data",
  "author": "LoTwT <l709937065@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/LoTwT/zzz-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/zzz-data.git"
  },
  "bugs": {
    "url": "https://github.com/LoTwT/zzz-data/issues"
  },
  "keywords": [
    "zenless zone zero",
    "zzz",
    "zzz data"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./data/*": "./data/*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "data",
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/generate/index.ts",
    "crawl": "tsx scripts/crawl/index.ts",
    "test": "vitest run",
    "build": "tsdown",
    "release": "pnpm run build && pnpm publish"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.52.0",
    "tsdown": "^0.16.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.18"
  }
}
