    "skillNameTexts": {
      "en": "Energetic Strike",
      "zh-CN": "元气一击"
    },
    "skillDescriptionsByRefine": {
      "1": {
        "en": "Increases the equipper's Anomaly Proficiency by 90. When the equipper is an Ether character, and comes on-field or uses a Special Attack or EX Special Attack, they gain a buff: DMG dealt to enemies afflicted with Attribute Anomalies increases by 20%, and all Attribute Anomaly DMG they trigger increases by 10%, lasting 15s. Repeated triggers reset the duration, and the effect is removed when switching off-field.",
        "zh-CN": "装备者的异常精通提升90点；以太属性的装备者进入前场或发动[特殊技]、[强化特殊技]时获得增益效果：对处于属性异常状态下的敌人造成的伤害提升20%，触发的所有属性异常伤害提升10%，效果持续15秒，重复触发时刷新持续时间，换回后场时该效果移除。"
      },
      "2": {
        "en": "Increases the equipper's Anomaly Proficiency by 103. When the equipper is an Ether character, and comes on-field or uses a Special Attack or EX Special Attack, they gain a buff: DMG dealt to enemies afflicted with Attribute Anomalies increases by 23%, and all Attribute Anomaly DMG they trigger increases by 11.5%, lasting 15s. Repeated triggers reset the duration, and the effect is removed when switching off-field.",
        "zh-CN": "装备者的异常精通提升103点；以太属性的装备者进入前场或发动[特殊技]、[强化特殊技]时获得增益效果：对处于属性异常状态下的敌人造成的伤害提升23%，触发的所有属性异常伤害提升11.5%，效果持续15秒，重复触发时刷新持续时间，换回后场时该效果移除。"
      },
      "3": {
        "en": "Increases the equipper's Anomaly Proficiency by 117. When the equipper is an Ether character, and comes on-field or uses a Special Attack or EX Special Attack, they gain a buff: DMG dealt to enemies afflicted with Attribute Anomalies increases by 26%, and all Attribute Anomaly DMG they trigger increases by 13%, lasting 15s. Repeated triggers reset the duration, and the effect is removed when switching off-field.",
        "zh-CN": "装备者的异常精通提升117点；以太属性的装备者进入前场或发动[特殊技]、[强化特殊技]时获得增益效果：对处于属性异常状态下的敌人造成的伤害提升26%，触发的所有属性异常伤害提升13%，效果持续15秒，重复触发时刷新持续时间，换回后场时该效果移除。"
      },
      "4": {
        "en": "Increases the equipper's Anomaly Proficiency by 130. When the equipper is an Ether character, and comes on-field or uses a Special Attack or EX Special Attack, they gain a buff: DMG dealt to enemies afflicted with Attribute Anomalies increases by 29%, and all Attribute Anomaly DMG they trigger increases by 14.5%, lasting 15s. Repeated triggers reset the duration, and the effect is removed when switching off-field.",
        "zh-CN": "装备者的异常精通提升130点；以太属性的装备者进入前场或发动[特殊技]、[强化特殊技]时获得增益效果：对处于属性异常状态下的敌人造成的伤害提升29%，触发的所有属性异常伤害提升14.5%，效果持续15秒，重复触发时刷新持续时间，换回后场时该效果移除。"
      },
      "5": {
        "en": "Increases the equipper's Anomaly Proficiency by 144. When the equipper is an Ether character, and comes on-field or uses a Special Attack or EX Special Attack, they gain a buff: DMG dealt to enemies afflicted with Attribute Anomalies increases by 32%, and all Attribute Anomaly DMG they trigger increases by 16%, lasting 15s. Repeated triggers reset the duration, and the effect is removed when switching off-field.",
        "zh-CN": "装备者的异常精通提升144点；以太属性的装备者进入前场或发动[特殊技]、[强化特殊技]时获得增益效果：对处于属性异常状态下的敌人造成的伤害提升32%，触发的所有属性异常伤害提升16%，效果持续15秒，重复触发时刷新持续时间，换回后场时该效果移除。"
      }
    }
  }
