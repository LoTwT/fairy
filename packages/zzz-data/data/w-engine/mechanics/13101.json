    "skillDescriptionsByRefine": {
      "1": {
        "en": "Increases Electric DMG by 15%. When the equipper hits an enemy with a Dodge Counter or Assist Attack, their Energy Generation Rate increases by 18% for 8s.",
        "zh-CN": "电属性伤害提升15%；[闪避反击]或[支援攻击]命中敌人时，装备者的能量获得效率提升18%，持续8秒。"
      },
      "2": {
        "en": "Increases Electric DMG by 17.5%. When the equipper hits an enemy with a Dodge Counter or Assist Attack, their Energy Generation Rate increases by 20.5% for 8s.",
        "zh-CN": "电属性伤害提升17.5%；[闪避反击]或[支援攻击]命中敌人时，装备者的能量获得效率提升20.5%，持续8秒。"
      },
      "3": {
        "en": "Increases Electric DMG by 20%. When the equipper hits an enemy with a Dodge Counter or Assist Attack, their Energy Generation Rate increases by 23% for 8s.",
        "zh-CN": "电属性伤害提升20%；[闪避反击]或[支援攻击]命中敌人时，装备者的能量获得效率提升23%，持续8秒。"
      },
      "4": {
        "en": "Increases Electric DMG by 22%. When the equipper hits an enemy with a Dodge Counter or Assist Attack, their Energy Generation Rate increases by 25% for 8s.",
        "zh-CN": "电属性伤害提升22%；[闪避反击]或[支援攻击]命中敌人时，装备者的能量获得效率提升25%，持续8秒。"
      },
      "5": {
        "en": "Increases Electric DMG by 24%. When the equipper hits an enemy with a Dodge Counter or Assist Attack, their Energy Generation Rate increases by 27.5% for 8s.",
        "zh-CN": "电属性伤害提升24%；[闪避反击]或[支援攻击]命中敌人时，装备者的能量获得效率提升27.5%，持续8秒。"
      }
