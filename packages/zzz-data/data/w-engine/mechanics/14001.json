      },
      "2": {
        "en": "Increases ATK by 8.6%. Landing a critical hit on an enemy will inflict an additional 200% of ATK as DMG. This effect can trigger once every 7.5s.",
        "zh-CN": "攻击力提升8.6%；攻击命中敌人并触发暴击时，额外造成200%攻击力的伤害，7.5秒内最多触发一次。"
      },
      "3": {
        "en": "Increases ATK by 9.7%. Landing a critical hit on an enemy will inflict an additional 200% of ATK as DMG. This effect can trigger once every 7s.",
        "zh-CN": "攻击力提升9.7%；攻击命中敌人并触发暴击时，额外造成200%攻击力的伤害，7秒内最多触发一次。"
      },
      "4": {
        "en": "Increases ATK by 10.8%. Landing a critical hit on an enemy will inflict an additional 200% of ATK as DMG. This effect can trigger once every 6.5s.",
        "zh-CN": "攻击力提升10.8%；攻击命中敌人并触发暴击时，额外造成200%攻击力的伤害，6.5秒内最多触发一次。"
      },
      "5": {
        "en": "Increases ATK by 12%. Landing a critical hit on an enemy will inflict an additional 200% of ATK as DMG. This effect can trigger once every 6s.",
