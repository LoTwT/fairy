    "skillDescriptionsByRefine": {
      "1": {
        "en": "While off-field, the equipper's Energy Regen increases by 0.6/s.\nWhen using an EX Special Attack, the equipper's Impact is increased by 10% for 10s, stacking up to 2 times. The duration of each stack is calculated separately.",
        "zh-CN": "位于后场时，装备者的能量自动回复提升0.6点/秒；发动[强化特殊技]时，装备者的冲击力提升10%，最多叠加2层，持续10秒，每层效果单独结算持续时间。"
      },
      "2": {
        "en": "While off-field, the equipper's Energy Regen increases by 0.75/s.\nWhen using an EX Special Attack, the equipper's Impact is increased by 12.5% for 10s, stacking up to 2 times. The duration of each stack is calculated separately.",
        "zh-CN": "位于后场时，装备者的能量自动回复提升0.75点/秒；发动[强化特殊技]时，装备者的冲击力提升12.5%，最多叠加2层，持续10秒，每层效果单独结算持续时间。"
      },
      "3": {
        "en": "While off-field, the equipper's Energy Regen increases by 0.9/s.\nWhen using an EX Special Attack, the equipper's Impact is increased by 15% for 10s, stacking up to 2 times. The duration of each stack is calculated separately.",
        "zh-CN": "位于后场时，装备者的能量自动回复提升0.9点/秒；发动[强化特殊技]时，装备者的冲击力提升15%，最多叠加2层，持续10秒，每层效果单独结算持续时间。"
      },
      "4": {
        "en": "While off-field, the equipper's Energy Regen increases by 1.05/s.\nWhen using an EX Special Attack, the equipper's Impact is increased by 17.5% for 10s, stacking up to 2 times. The duration of each stack is calculated separately.",
        "zh-CN": "位于后场时，装备者的能量自动回复提升1.05点/秒；发动[强化特殊技]时，装备者的冲击力提升17.5%，最多叠加2层，持续10秒，每层效果单独结算持续时间。"
      },
      "5": {
        "en": "While off-field, the equipper's Energy Regen increases by 1.2/s.\nWhen using an EX Special Attack, the equipper's Impact is increased by 20% for 10s, stacking up to 2 times. The duration of each stack is calculated separately.",
        "zh-CN": "位于后场时，装备者的能量自动回复提升1.2点/秒；发动[强化特殊技]时，装备者的冲击力提升20%，最多叠加2层，持续10秒，每层效果单独结算持续时间。"
      }
    }
