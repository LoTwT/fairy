  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "苍角发动[展旗]时，自身攻击力提升，提升数值等同于苍角20%初始攻击力，最高不超过500点，持续22秒，发动[展旗]并消耗[涡流]时，该增益效果翻倍，最高不超过1000点。队伍中其他角色通过[展旗]所触发的[快速支援]或[连携技]入场时，该增益效果将传递给对应的角色，并刷新其持续时间。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在与自身属性或阵营相同的角色时触发：\n苍角消耗[涡流]发动[展旗]时，全队角色造成的冰属性伤害提升20%，持续22秒。"
    },
    "cinemaTexts": [
      {
        "en": "When Soukaku triggers Core Passive: Blade Banner or Additional Ability: Group Set Meal, the buff duration is increased by 8s.",
        "zh-CN": "苍角触发[核心被动：刃旗助威]或[额外能力：团膳套餐]时，增益效果的持续时间提升8秒。"
      },
      {
        "en": "When Soukaku's Basic Attack, Dash Attack, Dodge Counter, or Quick Assist hits an enemy, there's a 15% chance she gains 1 stack of Vortex, triggering up to once per second.\nWhen Vortex reaches max stacks, any additional stacks grant Soukaku 1.2 Energy instead.",
        "zh-CN": "[普通攻击]、[冲刺攻击]、[闪避反击]、[快速支援]命中敌人时，苍角有15%的概率获得一层[涡流]，1秒内最多触发一次；[涡流]层数到达上限后，若再次获得[涡流]，将改为苍角回复1.2点能量。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "If an enemy is hit by Fly the Flag, the target's Ice RES is reduced by 10% for 8s.",
        "zh-CN": "[展旗]攻击命中敌人时，目标的冰属性伤害抗性降低10%，持续8秒。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "While in the Frosted Banner state, the number of usable enhanced Basic Attacks and enhanced Dash Attacks is increased to 12, and also deal 45% more DMG.",
        "zh-CN": "[霜染刃旗]状态下，强化[普通攻击]和强化[冲刺攻击]的可发动次数提升至12次，且招式造成的伤害提升45%。"
      }
    ]
  }
