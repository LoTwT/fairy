  "effects": {
    "modifiers": [
      {
        "id": "1361:enemy-daze-vulnerability-bonus",
        "label": "核心被动目标失衡易伤倍率",
        "bucket": "modifier",
        "key": "dazeVulnerabilityBonus",
        "value": {
          "kind": "by-level",
          "inputKey": "coreSkillLevel",
          "values": {
            "1": 0.2,
            "2": 0.225,
            "3": 0.25,
            "4": 0.275,
            "5": 0.3,
            "6": 0.325,
            "7": 0.35
          }
        },
        "unit": "ratio",
        "target": "enemy",
        "conditionText": "「扳机」发动[追加攻击]命中敌人时，目标的失衡易伤倍率提升20%，持续5秒，通过这种途径施加的失衡易伤倍率提升效果，在目标未进入失衡状态时亦可生效。"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "「扳机」发动[追加攻击]命中敌人时，目标的失衡易伤倍率提升35%，持续5秒，通过这种途径施加的失衡易伤倍率提升效果，在目标未进入失衡状态时亦可生效。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[强攻]角色或与自身属性相同的角色时触发：\n「扳机」的暴击率高于40%时，每超过1%暴击率会使自身发动[追加攻击]造成的失衡值提升1.5%，最多提升75%。"
    },
    "cinemaTexts": [
      {
        "en": "The Stun DMG Multiplier applied through Core Passive: Soul-Searching Gaze is increased by an additional 20%. When activating Basic Attack: Harmonizing Shot, the cooldown is reduced to 2s. Purge gained upon hitting an enemy with the continuous fire or charged counter in Sniper Stance increases by 25%. Maximum Purge increases to 125.",
        "zh-CN": "通过[核心被动：破隙幽瞳]施加的失衡易伤倍率额外提升20%；发动[普通攻击：协奏狙杀]时，触发的冷却时间降低至2秒；在[狙击姿态]下发动连续射击或蓄力反击命中敌人时，获得的[绝意]值提升25%，[绝意]值上限提升至125点。"
      },
      {
        "en": "Upon using an Aftershock, Trigger gains 1 stack of Hunter's Gaze. When executing a Finishing Move in Sniper Stance, Trigger gains 2 stacks of Hunter's Gaze. Each stack of Hunter's Gaze increases all squad members' CRIT DMG by 6%, stacking up to 4 times, and lasting 10s. Repeated triggers reset the duration.",
        "zh-CN": "发动[追加攻击]时，「扳机」将获得1层[猎眸]；在[狙击姿态]下发动终结一击时，「扳机」将获得2层[猎眸]；每拥有1层[猎眸]，全队角色暴击伤害提升6%，最多叠加4层，持续10秒，重复触发时刷新持续时间。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Trigger enters or extends Coordinated Support, while the state is active, the next time other squad members trigger Basic Attack: Harmonizing Shot or Basic Attack: Harmonizing Shot - Tartarus, it will trigger Disconnect upon hitting an enemy, dealing additional DMG equal to 200% of Trigger's ATK and inflict Daze equal to 120% of Trigger's Impact. This skill has a relatively high Interrupt Level.",
        "zh-CN": "「扳机」进入或延长[协战状态]后，状态持续期间，队伍中其他角色下一次触发[普通攻击：协奏狙杀]或[普通攻击：协奏狙杀·冥狱]时，将会在招式命中敌人时触发[断离]效果，额外造成「扳机」200%攻击力的伤害，并累积「扳机」120%冲击力的失衡值；招式具有较高的打断等级。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Upon entering the battlefield, Trigger gains 5 Armor Break Rounds. For every 25 Purge consumed, Trigger gains 1 additional Armor Break Round, up to a maximum of 5 rounds. While possessing Armor Break Rounds, when Trigger hits a target in Sniper Stance, 1 Armor Break Round is consumed to deal additional Electric DMG equal to 1,200% of Trigger's ATK. Armor Break Round DMG is additionally increased by 50%. This effect can trigger once every 0.2s.",
        "zh-CN": "进入战场时，「扳机」可获得5枚[破甲凶弹]，每消耗25点[绝意]值，「扳机」可额外获得1枚[破甲凶弹]，上限5枚；拥有[破甲凶弹]时，「扳机」在[狙击姿态]中命中目标时，将消耗1枚[破甲凶弹]，额外对目标造成「扳机」1200%攻击力的电属性伤害，且[破甲凶弹]造成的伤害额外提升50%，0.2秒内最多触发一次。"
      }
    ]
  }
}