  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "进入战场时，卢西娅立刻获得60点[梦境值]，若在发动[随想]或[合唱]时，卢西娅的[梦境值]达到100点，会进入[梦境]状态；\n进入[梦境]状态时，将触发[快速支援]，并同时开启[以太帷幕·涌泉]，[以太帷幕·涌泉]生效期间，全队角色最大生命值提升5%，持续40秒，重复触发延长持续时间，最多延长至300秒；\n当卢西娅处于[梦境]状态中，发动任意[随想]时，会消耗25点[梦境值]将[随想]升级为[合唱]；其他操作中的角色攻击命中敌人时，会消耗25点[梦境值]发动[追加攻击]，[追加攻击]为[合唱]，卢西娅在发动招式升级或[追加攻击]后，8秒内不会触发[追加攻击]；\n卢西娅发动招式升级或[追加攻击]时，会为全队角色施加[巡梦童谣]状态，[巡梦童谣]状态下，角色造成的伤害提升20%，持续12秒，重复触发时刷新持续时间；\n[梦境值]不足或离开[以太帷幕]时，卢西娅退出[梦境]状态。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[命破]角色或[击破]角色时触发：\n施加[破暗]状态时，额外附加暴击伤害提升30%效果。"
    },
    "cinemaTexts": [
      {
        "en": "When Dreamer's Nursery Rhyme deals additional DMG, ignore 18% of enemy All-Attribute RES and have 5% increased Decibel Generation Rate. Each time Lucia performs a skill upgrade, she gains 1 stack of Echo, stacking up to 4 times. When Dreamer's Nursery Rhyme ends, if Lucia has any Echo stacks, 1 stack is consumed to reapply Dreamer's Nursery Rhyme to all squad members.",
        "zh-CN": "[巡梦童谣]状态额外附加造成伤害时无视敌人18%全属性伤害抗性和喧响值获取效率提升5%效果；且卢西娅发动招式升级时获得1层[回音]，最多叠加4层，当[巡梦童谣]状态结束时，若卢西娅持有[回音]，则会自动消耗1层并重新为全队角色施加[巡梦童谣]状态。"
      },
      {
        "en": "While Lucia is inside Ether Veil: Wellspring, Harmony deals 15% more DMG. Agents in the Darkbreaker state gain an additional 15% Sheer DMG increase while in Ether Veil: Wellspring.",
        "zh-CN": "卢西娅处于[以太帷幕·涌泉]内时[合唱]造成的伤害提升15%；拥有[破暗]状态的代理人处于[以太帷幕·涌泉]内时，额外获得贯穿伤害提升15%效果。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Ether Veil is activated or extended on the field, Lucia grants all squad members 100 Decibels. This effect can trigger once every 15s.",
        "zh-CN": "当场上有[以太帷幕]开启或延长时，卢西娅使全队角色获得100点喧响值，该效果15秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Lucia is inside any Ether Veil, her ATK increases by 2% of her initial Max HP, and Harmony always triggers a CRIT with Harmony CRIT DMG increased by 30%.",
        "zh-CN": "卢西娅处于任意[以太帷幕]内时，会根据自身初始最大生命值的2%提升自身攻击力，且[合唱]必定暴击，[合唱]造成暴击时暴击伤害提升30%。"
      }
    ]
  }
