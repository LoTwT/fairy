    ],
    "coreTexts": {
      "zh-CN": "格莉丝[普通攻击]或[冲刺攻击]命中敌人并造成物理伤害时，获得一层[电能]（上限8层）；[电能]层数到达上限后，发动[特殊技]或[强化特殊技]时，会消耗所有[电能]，使招式累积的电属性异常积蓄值提升130%。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在与自身属性或阵营相同的角色或其他[异常]角色时触发：\n格莉丝[强化特殊技]命中敌人时，目标下次被施加[感电]效果时，该次[感电]伤害提升18%，最多叠加2层，同一招式内每个敌人最多触发一次效果，[感电]状态结束时效果重置。"
    },
    "cinemaTexts": [
      {
        "en": "When the 4th hit of Grace's Basic Attack hits an enemy, all squad members gain 0.25 Energy.\nWithin the same move, this effect can grant a max of 2 Energy to all squad members.",
        "zh-CN": "[普通攻击]第四段每次命中敌人时，全队角色回复0.25点能量；\n同一招式内，该效果最多为全队回复2点能量。"
      },
      {
        "en": "When Grace's thrown grenade hits an enemy during a Basic Attack, Special Attack, or EX Special Attack, the target's Electric RES is reduced by 8.5%, and Electric Anomaly Buildup RES is reduced by 8.5%, lasting for 8s.",
        "zh-CN": "在[普通攻击]、[特殊技]、[强化特殊技]等招式中投掷手雷命中敌人时，目标的电属性伤害抗性降低8.5%，电属性异常积蓄抗性降低8.5%，持续8秒。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Grace uses her EX Special Attack, she gains 6 stacks of Charge (max 6 stacks). When her Basic Attack: High-Pressure Spike or Dash Attack: Quick Inspection hits an enemy, 1 stack of Charge is consumed, increasing her Energy Generation Rate of the attack by 20%.",
        "zh-CN": "发动[强化特殊技]时，格莉丝获得6层充能（上限6层）；[普通攻击：高压射钉]或[冲刺攻击：突击检查]命中敌人时，消耗1层充能，使当前招式的能量获得效率提升20%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When all Zap stacks are consumed to activate a Special Attack or EX Special Attack, Grace's skill is enhanced, tossing an extra grenade and increasing each grenade's DMG to 200%.",
        "zh-CN": "消耗所有[电能]发动[特殊技]或[强化特殊技]时，能够强化招式效果，额外投掷一颗手雷，并使每颗手雷造成的伤害提升至原本的200%。"
      }
    ]
  }
