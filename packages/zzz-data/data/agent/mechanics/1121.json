    "coreTexts": {
      "zh-CN": "本的初始攻击力随初始防御力提升，提升效果等同于自身初始防御力的80%；\n在[强化特殊技]中追加强力打击时，为全队角色提供等同于自身30%防御力+550点护盾，持续30秒。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在与自身属性或阵营相同的角色时触发：\n拥有[核心被动：守卫]施加的护盾时，角色的暴击率提升16%。"
    },
    "cinemaTexts": [
      {
        "en": "When successfully Blocking an enemy with Ben's Special Attack or EX Special Attack, the DMG dealt by the blocked enemy is reduced by 30% for 15s.",
        "zh-CN": "发动[特殊技]或[强化特殊技]，成功格挡敌人的攻击时，攻击者造成的伤害降低30%，持续15秒。"
      },
      {
        "en": "When successfully triggering a Block Counter during Ben's Special Attack or EX Special Attack, inflict an additional 300% of Ben's DEF as DMG.",
        "zh-CN": "在[特殊技]或[强化特殊技]中，成功触发格挡反击时，额外造成本300%防御力的伤害。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When successfully blocking enemy DMG with Ben's invulnerable effect during his Special Attack or EX Special Attack, the following counter deals 30% more DMG.",
        "zh-CN": "在[特殊技]或[强化特殊技]中，通过无敌效果成功格挡攻击时 ，后继反击造成的伤害提升30%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "After launching an attack or follow-up attack during Ben's EX Special Attack, Daze inflicted by Basic Attacks, Dash Attack, and Dodge Counter is increased by 20%, lasting 12s.",
        "zh-CN": "在[强化特殊技]中发动攻击或追加强力打击后，[普通攻击]、[冲刺攻击]、[闪避反击]造成的失衡值提升20%，持续12秒。"
      }
    ]
  }
