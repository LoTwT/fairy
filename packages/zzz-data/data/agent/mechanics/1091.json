  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "星见雅对敌人造成烈霜伤害时，将会为目标附着[冰焰]，持续30秒；对附着[冰焰]的敌人累积烈霜异常积蓄值时，会基于星见雅暴击率的100%提升烈霜异常积蓄效率，最多提升80%；星见雅累积烈霜异常积蓄值时，具有独立的属性异常积蓄槽，随之触发的[冻结]、[碎冰]和[霜寒]效果，可以与包括冰属性异常效果在内的其他属性异常效果互相结算[紊乱]；\n星见雅对附着[冰焰]的敌人施加[霜寒]效果时，将会消除[冰焰]并触发[霜灼·破]，对目标造成星见雅1500%攻击力的烈霜伤害，同时使目标进入[霜灼]状态；[霜灼]状态下，所有单位对目标累积的属性异常积蓄值提升20%，但星见雅无法再次为其附着[冰焰]；[霜灼]状态将会随本次[霜寒]效果一起结束，状态持续期间，对敌人重新施加属性异常效果可以覆盖[霜寒]并消除[霜灼]；\n触发[霜灼·破]时，星见雅获得1点[落霜]，10秒内最多触发一次。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[支援]角色或与自身阵营相同的角色时触发：\n[普通攻击：霜月]造成的伤害提升60%；队伍中任意角色触发[紊乱]效果时，星见雅获得2点[落霜]，且在下一次[霜月架势]期间，[普通攻击：霜月]将无视目标30%冰属性伤害抗性。"
    },
    "cinemaTexts": [
      {
        "en": "While in Shimotsuki Stance, every 1 point of Fallen Frost consumed will allow Basic Attack: Shimotsuki to ignore 6% of DEF, stacking up to 6 times and lasting until Shimotsuki Stance ends. When the slash for charge level three of Basic Attack: Shimotsuki hits an enemy under Frostburn, it will immediately remove the Frostburn state and increase all squad members' Anomaly Buildup Rate by 20% for 10s.",
        "zh-CN": "在[霜月架势]期间，每消耗1点[落霜]，[普通攻击：霜月]将无视目标6%防御力，最多叠加6层，退出[霜月架势]后增益效果结束；在[普通攻击：霜月]中进行三段蓄力，斩击命中处于[霜灼]状态下的敌人时，可以立即消除目标的[霜灼]状态，并使全队角色属性异常积蓄效率提升20%，持续10秒。"
      },
      {
        "en": "Basic Attack: Kazahana and Dodge Counter DMG increases by 30%. Hoshimi Miyabi gains 1 point of Fallen Frost when the final move of the 5th hit of Basic Attack: Kazahana hits an enemy. Upon entering the battlefield, Hoshimi Miyabi immediately obtains 6 points of Fallen Frost and her CRIT Rate increases by 15%.",
        "zh-CN": "[普通攻击：风花]和[闪避反击]造成的伤害提升30%；第五段[普通攻击：风花]最后一击命中敌人时，星见雅获得1点[落霜]；进入战场时，星见雅立刻获得6点[落霜]，自身暴击率提升15%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Frostburn - Break DMG increases by 30%. Upon triggering Frostburn - Break, Hoshimi Miyabi generates 250 more Decibels.",
        "zh-CN": "[霜灼·破]造成的伤害提升30%，触发[霜灼·破]时，星见雅额外获得250点喧响值。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "During Shimotsuki Stance, Hoshimi Miyabi obtains Polar, which increases Basic Attack: Shimotsuki DMG by 30%. After obtaining Polar, Hoshimi Miyabi will automatically draw her blade and unleash powerful slashes based on the current charge level upon consuming Fallen Frost. Before Fallen Frost is completely depleted, the draw and slashes will not interrupt charging under Shimotsuki Stance. Each occurrence of Shimotsuki Stance can perform up to 3 draws and slashes.",
        "zh-CN": "在[霜月架势]期间，星见雅将获得[极意]效果，使[普通攻击：霜月]造成的伤害提升30%，获得[极意]效果后，消耗[落霜]时，星见雅会根据当前蓄力段数，自动拔刀向前方发动强力斩击；在[落霜]耗尽前，拔刀斩击不会打断[霜月架势]下的蓄力进度；在一次[霜月架势]期间，最多连续发动3次拔刀斩击。"
      }
    ]
  }
}