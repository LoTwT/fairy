  "effects": {
    "modifiers": [
      {
        "id": "1411:self-damage-bonus",
        "label": "核心被动自身造成伤害",
        "bucket": "modifier",
        "key": "damageBonus",
        "value": {
          "kind": "by-level",
          "inputKey": "coreSkillLevel",
          "values": {
            "1": 0.15,
            "2": 0.15,
            "3": 0.15,
            "4": 0.15,
            "5": 0.15,
            "6": 0.15,
            "7": 0.15
          }
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "[狸之愿]效果会提供等同于柚叶的40%初始攻击力的攻击力加成，最多提升600点，并使拥有者造成的伤害提升15%，持续40秒，重复触发时刷新持续时间"
      },
      {
        "id": "1411:cinema:2:team-damage-bonus",
        "label": "影画2全队造成伤害",
        "bucket": "modifier",
        "key": "damageBonus",
        "value": {
          "kind": "static",
          "value": 0.15
        },
        "unit": "ratio",
        "target": "team",
        "conditionText": "柚叶的[强化特殊技：小心蛀牙]、[强化特殊技：小心蛀牙，就是现在！]和[终结技：不投降就捣乱]攻击命中敌人时，会使全队角色造成的伤害提升15%，属性异常积蓄效率提升15%，持续40秒，重复触发时刷新持续时间，重击命中不处于失衡状态的敌人时，会强制触发[连携技]，通过该种方式发动的[连携技]，打断等级降低，强制触发[连携技]的效果每20秒最多触发一次"
      },
      {
        "id": "1411:cinema:4:self-damage-bonus",
        "label": "影画4自身造成伤害",
        "bucket": "modifier",
        "key": "damageBonus",
        "value": {
          "kind": "static",
          "value": 0.3
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "柚叶的[支援突击：夹心硬糖射击]和[支援突击：来块曲奇]造成的伤害提升30%，属性异常积蓄效率提升20%，且该招式命中敌人时将触发[快速支援]。"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "进入战场时，柚叶立刻获得3点[甜度点]；\n柚叶最多持有6点[甜度点]；\n柚叶的[强化特殊技：小心蛀牙]、[强化特殊技：小心蛀牙，就是现在！]和[终结技：不投降就捣乱]攻击命中敌人时，为全队角色施加[狸之愿]效果；\n[狸之愿]效果会提供等同于柚叶的40%初始攻击力的攻击力加成，最多提升1200点，并使拥有者造成的伤害提升15%，持续40秒，重复触发时刷新持续时间；\n当柚叶的初始攻击力达到3000点时，为全队角色提供的攻击力增益效果达到最大值。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[异常]角色或与自身阵营相同的角色时触发：\n若柚叶的异常掌控大于100点，每超过1点异常掌控会使拥有[狸之愿]效果的角色的属性异常积蓄效率提升0.2%，最多提升20%，还会使其所有属性异常伤害和[紊乱]伤害提升0.2%，最多提升20%，当柚叶的异常掌控达到200点时，上述增益效果达到最大值。"
    },
    "cinemaTexts": [
      {
        "en": "Yuzuha regains 30 Energy when she enters the battlefield. In Investigation Zone Mode, this effect can trigger at most once every 180s. Enemies in the Sweet Scare state have their All-Attribute RES reduced by 10%. The Attribute Anomaly DMG and Disorder DMG buff from her Additional Ability is increased to 130% of its original value.",
        "zh-CN": "柚叶进入战场时，回复30点能量，在勘域模式中该效果每180秒最多触发一次；处于[甜蜜惊吓]状态下的敌人全属性伤害抗性降低10%；[额外能力]中属性异常伤害和[紊乱]伤害增益效果提升至原本的130%。"
      },
      {
        "en": "When Yuzuha's EX Special Attack: Cavity Alert, EX Special Attack: Cavity Alert, Right Now!, or Ultimate: Surrender or Suffer the Mischief hits an enemy, all squad members' DMG increases by 15% and Anomaly Buildup Rate by 15%, lasting 40s and repeated triggers reset the duration. When a heavy attack hits an enemy that is not Stunned, it will trigger a forced Chain Attack. Chain Attacks triggered this way have reduced Interrupt Level and forced Chain Attacks can only occur once every 20s. Whenever another character enters through a Chain Attack, Yuzuha gains 1 Sugar Points. Yuzuha's Basic Attack: Hard Candy Shot cooldown is reduced by 25%.",
        "zh-CN": "柚叶的[强化特殊技：小心蛀牙]、[强化特殊技：小心蛀牙，就是现在！]和[终结技：不投降就捣乱]攻击命中敌人时，会使全队角色造成的伤害提升15%，属性异常积蓄效率提升15%，持续40秒，重复触发时刷新持续时间，重击命中不处于失衡状态的敌人时，会强制触发[连携技]，通过该种方式发动的[连携技]，打断等级降低，强制触发[连携技]的效果每20秒最多触发一次；其他角色通过[连携技]入场时，柚叶会获得1点[甜度点]；柚叶触发[普通攻击：硬糖射击]的冷却时间减少25%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "The DMG of Yuzuha's Assist Follow-Up: Stuffed Hard Candy Shot and Assist Follow-Up: We Have Cookies increases by 30%, Anomaly Buildup Rate by 20%, and triggers a Quick Assist when it hits an enemy.",
        "zh-CN": "柚叶的[支援突击：夹心硬糖射击]和[支援突击：来块曲奇]造成的伤害提升30%，属性异常积蓄效率提升20%，且该招式命中敌人时将触发[快速支援]。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Gain 1 additional Sugar Points when successfully parrying an enemy attack using a Defensive Assist or Basic Attack: Tanuki Cloak. When using Assist Follow-Up: Stuffed Hard Candy Shot, hold  to charge for up to 0.8 seconds. Releasing  or reaching full charge fires an extra powerful shell at the enemy. For every 0.4s charged, Yuzuha consumes 1 Sugar Point to fire an additional powerful shell, each dealing 300% of her ATK as Physical DMG. If any powerful shell from Assist Follow-Up: Stuffed Hard Candy Shot hits an enemy, all squad members' Disorder DMG Multiplier increases by 105% for 40s, and stacking up to 3 times, with each stack duration being calculated separately. In addition, if the powerful shell hits an enemy under Sweet Scare, it'll trigger 1 Basic Attack: Sugarburst Sparkles - Max attack. If Yuzuha is attacked while charging, she will automatically dodge the attack and immediately unleash the max-charged attack.",
        "zh-CN": "通过[招架支援]或[普通攻击：狸之帐]成功招架敌人攻击时额外获得1点[甜度点]，发动[支援突击：夹心硬糖射击]时可以长按进行蓄能，最多持续0.8秒，松开或蓄能至最大时间时，柚叶会额外发射强力炮弹攻击敌人。每蓄能0.4秒，柚叶都会消耗1点[甜度点]追加发射一枚强力炮弹，每颗追加强力炮弹攻击造成柚叶300%攻击力的物理伤害；[支援突击：夹心硬糖射击]的任意强力炮弹命中敌人时，会使全队角色[紊乱]效果的伤害倍率提升105%，持续40秒，最多叠加3层，每层单独结算持续时间，额外强力炮弹命中处于[甜蜜惊吓]状态的敌人时也会触发1次[普通攻击：彩糖花火·极]攻击；柚叶蓄能过程中如果受到敌人攻击，会自动闪避敌人攻击并直接发动最大蓄能攻击。"
      }
    ]
  }
}