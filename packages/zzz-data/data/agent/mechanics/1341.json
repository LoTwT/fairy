  "effects": {
    "modifiers": [
      {
        "id": "1341:cinema:4:self-crit-damage",
        "label": "影画4自身暴击伤害",
        "bucket": "modifier",
        "key": "critDamage",
        "value": {
          "kind": "static",
          "value": 0.4
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "[终结技]、[连携技]和[普通攻击：最终裁决]的暴击伤害提升40%。"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "照会额外根据初始最大生命值提高暴击率，每1000点初始最大生命值提高1.4%暴击率；\n进入战场时，照获得100点[霜寒值]，在勘域模式中此效果180秒内最多触发一次，[霜寒值]的上限为100点；\n当前操作中角色攻击命中敌人时，照积攒6点[霜寒值]，每3秒最多触发一次；\n[霜寒值]满时，如果处于接战状态下，将照换入前场可以发动[登场技]；\n照发动[登场技]时，消耗所有[霜寒值]，开启[以太帷幕·涌泉]；\n[以太帷幕·涌泉]生效期间，全队角色最大生命值提升5%，持续40秒，照重复开启[以太帷幕·涌泉]前，将关闭已有的[以太帷幕·涌泉]；\n照开启[以太帷幕·涌泉]时，使全队角色的攻击力提升1000点，持续50秒，重复触发时刷新持续时间。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[强攻]或[异常]或[支援]角色时触发：\n照处于任意[以太帷幕]中时，使全队造成的伤害提升10%，照的初始最大生命值高于15000点时，每超过400点初始最大生命值，可使增伤效果额外提升1%，初始效果与额外提升最大总共提升至40%，当初始最大生命值达到27000点时，上述增益效果达到最大值。"
    },
    "cinemaTexts": [
      {
        "en": "When Zhao switches out of being the active character, all squad members' DMG ignores 15% of the target's All-Attribute RES for 50s.",
        "zh-CN": "照被切换为非当前操作角色时，使全队角色造成的伤害无视目标15%全属性伤害抗性，持续50秒，重复触发时刷新持续时间。"
      },
      {
        "en": "When Zhao recovers HP, her ATK increases by 20%, and other squad members' ATK increases by 15% for 50s. Repeated triggers reset the duration.",
        "zh-CN": "照的生命值回复时，提升20%攻击力，并使队伍中其他角色提升15%攻击力，持续50秒，重复触发时刷新持续时间。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Zhao activates an Ether Veil, she gains 250 Decibels. The CRIT DMG of her Ultimate, Chain Attack, and Basic Attack: Final Verdict increase by 40%.",
        "zh-CN": "照开启[以太帷幕]时，获得250点喧响值；[终结技]、[连携技]和[普通攻击：最终裁决]的暴击伤害提升40%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "The CRIT Rate buff from Core Passive: Ideal Colleague increases to 125% of the original value. The extra DMG gained from charging during Basic Attack: Final Verdict increases to 140% of the original value, and accumulated charge time is no longer consumed when attacking.",
        "zh-CN": "[核心被动：最佳同事]提高暴击率的效果提升至原本的125%；[普通攻击：最终裁决]累积蓄力时长的额外伤害提升至原本的140%，并使累积的蓄力时长不会在攻击中被消耗。"
      }
    ]
  }
}