      {
        "id": "1501:cinema:6:self-以太-damage-bonus",
        "label": "影画6自身以太属性伤害",
        "bucket": "modifier",
        "key": "etherDamageBonus",
        "value": {
          "kind": "static",
          "value": 0.4
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "且爱芮进入[妄想时刻]后将不会退出，强化版[普通攻击：绝对音准]和[终结技]造成的以太伤害提升40%"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "爱芮的异常精通提升90点；\n爱芮的第三段[普通攻击：绝对音准]重击命中处于以太异常状态、电属性异常状态、火属性异常状态、物理属性异常状态、冰属性异常状态的目标时，触发一次[异放]：额外结算一次属性异常伤害，相对于原属性异常伤害的比例为每10点初始异常掌控27.5%/14.3%/35.7%/2.5%/3.6%，当目标处于失衡状态下时，该伤害比例额外提升50%。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[击破]、[支援]或与自身阵营相同的角色时触发：\n当有[以太帷幕]开启时，会在场上生成4个[应援能量]，1秒内最多触发1次；\n队伍中任意角色对敌人施加[侵蚀]效果时，该效果的持续时间提升3秒。"
    },
    "cinemaTexts": [
      {
        "en": "When Aria's Basic Attack, Special Attack, or EX Special Attack deals DMG to enemies, it ignores 10% of the target's Ether Anomaly Buildup RES. Additionally, when Aria triggers Abloom, it has a chance to trigger a critical hit. The base CRIT Rate is 25%, and CRIT DMG is 25%. If initial Anomaly Mastery exceeds 100, each additional point of initial Anomaly Mastery increases this effect's CRIT Rate by 0.5%.",
        "zh-CN": "爱芮的[普通攻击]、[特殊技]，[强化特殊技]对敌人造成伤害时，无视目标10%的以太异常积蓄抗性；且自身触发[异放]时有概率触发暴击：基础暴击率为25%，暴击伤害为25%；若初始异常掌控大于100点，每超过1点初始异常掌控会使该效果的暴击率额外提升0.5%。"
      },
      {
        "en": "When Aria attacks or triggers Abloom, it ignores 16% of the target's DEF. During Moment of Delusion, attacks and Abloom triggers also ignore an additional 8% of the target's DEF.",
        "zh-CN": "爱芮攻击和触发[异放]时无视目标16%防御力；在[妄想时刻]持续时间内，攻击和触发[异放]时额外无视目标8%防御力。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Aria triggers Abloom, she gains 4 Energy and 70 Decibels. This effect can trigger once every 10s.",
        "zh-CN": "爱芮触发[异放]时，自身获得4点能量和70点喧响值，10秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Upon entering the battlefield, Aria immediately gains 1,200 Decibels. In Investigation Zone mode, this effect can trigger once every 180s. After Aria enters Moment of Delusion, she will not exit it, and enhanced Basic Attack: Perfect Pitch and her Ultimate deal 40% increased Ether DMG. While in Moment of Delusion, when an enemy on the field enters an Anomaly state, Aria gains 1 stacks of All-Out Cheering. This effect can occur once every 6s. When gaining the All-Out Cheering effect, if already at 3 stacks of All-Out Cheering, any excess All-Out Cheering is converted into 2 Fandom Power and generated on the field.",
        "zh-CN": "进入战场时，爱芮立即获得1200点喧响值，在勘域模式中此效果180秒内最多触发一次；且爱芮进入[妄想时刻]后将不会退出，强化版[普通攻击：绝对音准]和[终结技]造成的以太伤害提升40%；当爱芮处于[妄想时刻]时，若场上有敌人进入属性异常状态，爱芮获得1层[全场应援]，该效果6秒内最多触发一次；在获得[全场应援]效果时，若自身已有3层[全场应援]效果，则会将溢出的[全场应援]效果转化为2个[应援能量]生成在场上。"
      }
    ]
  }
