  "effects": {
    "modifiers": [
      {
        "id": "1311:cinema:6:self-crit-rate",
        "label": "影画6自身暴击率",
        "bucket": "modifier",
        "key": "critRate",
        "value": {
          "kind": "static",
          "value": 0.8
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "在[咏叹华彩]状态下释放和追加释放的[震音]和[音簇]的伤害倍率提升至原本的200%，暴击率提升80%"
      },
      {
        "id": "1311:cinema:6:self-crit-rate",
        "label": "影画6自身暴击率",
        "bucket": "modifier",
        "key": "critRate",
        "value": {
          "kind": "static",
          "value": 0.8
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "触发[精准支援]时，耀嘉音会自动追加发动蓄力完成后的[普通攻击：《随想曲》]第三段攻击，并使该招式的暴击率提升80%，10秒内最多触发一次。"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "[咏叹华彩]状态下，队伍中其他角色通过[快速支援]、[连携技]、[招架支援]或[回避支援]入场，耀嘉音消耗能量追加释放[震音]进行攻击时，耀嘉音和入场角色的攻击力提升，提升效果等同于耀嘉音初始攻击力的35%，最高不超过1200点，持续20秒，重复触发时延长持续时间，最多不超过30秒。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[强攻]、[异常]或[命破]角色时触发：\n消耗能量发动[精准支援]或[普通攻击：终曲]时，耀嘉音将额外追加释放1道[震音]和3枚[音簇]进行攻击。"
    },
    "cinemaTexts": [
      {
        "en": "When Astra Yao's attack hits an enemy, the target's All-Attribute RES is reduced by 6%, stacking up to 3 times and lasting 30s. Repeated triggers reset the duration. Upon entering the battlefield, Astra Yao immediately gains 1,000 Decibels. When activating her Ultimate, all squad members gain 1 stack of Song of Protection for 60s. When attacked by an enemy, consume Song of Protection, granting Invulnerability for 1s.",
        "zh-CN": "耀嘉音攻击命中敌人时，目标的全属性伤害抗性降低6%，最多叠加3层，持续30秒，重复触发时刷新持续时间；进入战场时，耀嘉音立刻获得1000点喧响值；发动[终结技]时，全队角色各自获得1层[庇佑之音]效果，持续60秒，受到敌方攻击时，将消耗[庇佑之音]并获得无敌效果，持续1秒。"
      },
      {
        "en": "The ATK buff from Core Passive: \"Graceful Andante\" is further increased by 19%, with an increased maximum of 400. While in the Idyllic Cadenza state, when other squad members switch in through a Quick Assist, Chain Attack, Defensive Assist, or Evasive Assist, Astra Yao will additionally follow up with 1 Tremolo and 3 Tone Clusters to attack. This effect can trigger once every 3s.",
        "zh-CN": "[核心被动：《如歌的行板》]中的攻击力提升效果额外提升19%，上限额外提升400点；[咏叹华彩]状态下，队伍中其他角色通过[快速支援]、[连携技]、[招架支援]或[回避支援]入场时，耀嘉音将额外追加释放1道[震音]和3枚[音簇]进行攻击，3秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "After activating a Chain Attack or Ultimate, within 15s, Astra Yao can trigger a Quick Assist even if she does not have Chords. When the attack hits an enemy, the interval for triggering a Quick Assist is reduced to 1s. While in the Idyllic Cadenza state, when other squad members enter the field via a Quick Assist, they will receive different buffs based on their specialty, and this effect can be triggered once every 3s for the entire squad: Attack: The next Quick Assist heavy attack on an enemy will deal extra DMG equal to 300% of Astra Yao's ATK; Anomaly: The next Quick Assist will have 50% increased Anomaly Buildup; Stun: The next Quick Assist will inflict 50% increased Daze.",
        "zh-CN": "发动[连携技]或[终结技]后，15秒内，耀嘉音未拥有[和弦]时也能够触发[快速支援]，且攻击命中敌人时触发[快速支援]的间隔缩短至1秒；[咏叹华彩]状态下，队伍中其他角色通过[快速支援]入场时，将根据自身特性获得不同的增益效果，全队3秒内最多触发一次：[强攻]：下一次[快速支援]重击命中敌人时，额外造成等同于耀嘉音300%攻击力的伤害；[异常]：下一次[快速支援]累积的属性异常积蓄值提升50%；[击破]：下一次[快速支援]造成的失衡值提升50%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "While in the Idyllic Cadenza state, the DMG multiplier for Tremolo and Tone Clusters released or followed up with will increase to 200% of the original, and CRIT Rate is increased by 80%. When triggering a Precise Assist, Astra Yao will automatically follow up with the charged 3rd-hit of Basic Attack: \"Capriccio\", with a 80% increased CRIT Rate. This effect can trigger once every 10s.",
        "zh-CN": "在[咏叹华彩]状态下释放和追加释放的[震音]和[音簇]的伤害倍率提升至原本的200%，暴击率提升80%；触发[精准支援]时，耀嘉音会自动追加发动蓄力完成后的[普通攻击：《随想曲》]第三段攻击，并使该招式的暴击率提升80%，10秒内最多触发一次。"
      }
    ]
  }
