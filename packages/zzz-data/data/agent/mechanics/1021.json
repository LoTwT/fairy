    "coreTexts": {
      "zh-CN": "猫又[闪避反击]或[快速支援]命中敌人时，自身造成的伤害提升60%，持续6秒。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在与自身属性或阵营相同的角色时触发：\n队伍中任意角色对敌人施加[强击]效果后，猫又下一次发动[强化特殊技]时，招式造成的伤害提升35%，最多叠加2层。"
    },
    "cinemaTexts": [
      {
        "en": "When Nekomata hits an enemy from behind, she ignores 16% of her target's Physical RES. If the enemy is Stunned, all Nekomata's attacks against them are considered back attacks.",
        "zh-CN": "从背后攻击命中敌人时，猫又无视目标16%物理伤害抗性；敌方处于失衡状态时，猫又对其的所有攻击均被视为背后攻击。"
      },
      {
        "en": "When there's only one enemy on the field and Nekomata is in combat, her Energy Generation Rate is increased by 25%.",
        "zh-CN": "当场上只有一名敌人且自身位于前场时，猫又的能量获得效率提升25%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Nekomata uses her EX Special Attack, her CRIT Rate increases by 7% for 15s, stacking up to 2 times, with each stack's duration being calculated separately.",
        "zh-CN": "发动[强化特殊技]时，猫又的暴击率提升7%，最多叠加2层，持续15秒，每层效果单独结算持续时间。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Nekomata launches a Chain Attack or uses her Ultimate, her CRIT DMG increases by 18%, stacking up to 3 times. The effect expires when she's no longer in-combat. This effect gains maximum stacks immediately on defeating an enemy.",
        "zh-CN": "发动[连携技]或[终结技]时，猫又的暴击伤害提升18%，最多叠加3层，退出接战状态时增益效果结束；猫又击败敌人时，该增益效果直接叠加至层数上限。"
      }
    ]
  }
