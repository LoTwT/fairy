  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "指派杜苏拉或安娜塔莎进行攻击时，队伍中其他角色的穿透率随丽娜自身的穿透率提升，提升效果等同于丽娜25%穿透率+12%，最高提升30%，杜苏拉和安娜塔莎均返回丽娜身边后，对应增益效果结束。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在与自身属性或阵营相同的角色时触发：\n队伍中任意角色对敌人施加[感电]效果时，该效果的持续时间提升3秒；场上存在处于[感电]状态下的敌人时，全队角色造成的电属性伤害提升10%。"
    },
    "cinemaTexts": [
      {
        "en": "After being sent out to launch an attack, Drusilla and Anastella stay in place for an additional 5.5s before returning to Rina.\nThe effect gained from Core Passive: Mini Destruction Partner by characters within 10m is increased to 130% of the original value.",
        "zh-CN": "被指派并发动攻击后，返回丽娜身边前，杜苏拉和安娜塔莎会在原处额外逗留5.5秒；在杜苏拉或安娜塔莎附近10米范围内的角色，从[核心被动：迷你毁灭拍档]中获得的增益效果提升至原本的130%。"
      },
      {
        "en": "Upon becoming the active character in combat, Rina's DMG increases by 15% for 12s. This effect can trigger once every 18s.",
        "zh-CN": "成为接战状态下的当前操作角色时，丽娜造成的伤害提升15%，持续12秒，18秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Rina's Energy Regen increases by 0.5/s when both Drusilla and Anastella are deployed. The effect ends when Drusilla or Anastella returns to Rina.",
        "zh-CN": "杜苏拉和安娜塔莎均被指派在外时，丽娜的能量自动回复速度提升0.5点/秒；杜苏拉或安娜塔莎返回丽娜身边时，对应增益效果结束。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When an EX Special Attack, Chain Attack or Ultimate hits an enemy, the entire squad's Electric DMG is increased by 15% for 8s.",
        "zh-CN": "[强化特殊技]、[连携技]或[终结技]命中敌人时，全队角色造成的电属性伤害提升15%，持续8秒。"
      }
    ]
  }
