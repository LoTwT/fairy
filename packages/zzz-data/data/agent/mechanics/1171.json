  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "柏妮思消耗能量值时，会为自身累积[燃点]，最多累积100点；每消耗1点能量值，能够累积1.4点[燃点]，当[燃点]累积至50点时，柏妮思将进入[燃油特调]状态，直到[燃点]耗尽；进入战场时，柏妮思立刻累积100点[燃点]；\n[燃油特调]状态下，柏妮思的[普通攻击：炽焰搅拌式]、[强化特殊技：灼热摇荡法]、[强化特殊技：灼热摇荡法·双份]、[连携技：燃油熔焰]或[终结技：纵享盛焰]命中敌人时，将对目标施加[灼伤]效果，直到柏妮思退出[燃油特调]状态；队伍中其他角色攻击命中处于[灼伤]状态下的敌人时，会触发[余烬]效果，消耗8点[燃点]，对目标造成等同于柏妮思350%攻击力的火属性伤害并累积火属性异常积蓄值，1.5秒内最多触发一次；每拥有10点异常精通，[余烬]效果造成的伤害提升1%，最多提升30%；[余烬]效果造成的伤害被视为[支援攻击]伤害。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在其他[异常]角色或与自身阵营相同的角色时触发：\n柏妮思[普通攻击：炽焰搅拌式]、[强化特殊技：灼热摇荡法]、[强化特殊技：灼热摇荡法·双份]命中敌人，或触发[余烬]效果时，招式累积的火属性异常积蓄值提升65%；队伍中任意角色对敌人施加[灼烧]效果时，该效果的持续时间提升3秒。"
    },
    "cinemaTexts": [
      {
        "en": "Increases the limit of Heat from 100 to 140. Upon entering the battlefield, Burnice accumulates an additional 40 Heat. Increases the DMG Multiplier of the Afterburn effect by 100% of Burnice's ATK. Additionally, the accumulated Fire Anomaly Buildup from the Afterburn effect is increased by 25%.",
        "zh-CN": "[燃点]的上限从100点提升至140点，进入战场时，柏妮思额外累积40点[燃点]；[余烬]效果的伤害倍率提升，提升效果等同于柏妮思攻击力的100%；[余烬]效果累积的火属性异常积蓄值提升25%。"
      },
      {
        "en": "When triggering the Afterburn effect, Thermal Penetration is applied to the enemy, stacking up to 5 times and lasting 6s. Repeated triggers reset the duration. When any allied unit in the squad hits the enemy, the attack's PEN Ratio is increased by 4% for each stack of Thermal Penetration, up to a max of 20%.",
        "zh-CN": "触发[余烬]效果时，将对敌人施加[热意洞穿]，最多叠加5层，持续6秒，重复触发时刷新持续时间；受到我方攻击时，目标每拥有一层[热意洞穿]，本次攻击的穿透率提升4%，最多提升20%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When an EX Special Attack or Assist Attack hits an enemy, the move's CRIT Rate increases by 30%. The max flame spray duration of EX Special Attack: Intense Heat Stirring Method - Double Shot is increased by 1s.",
        "zh-CN": "[强化特殊技]或[支援攻击]命中敌人时，招式的暴击率提升30%；[强化特殊技：灼热摇荡法·双份]中，火焰喷射的持续时间上限提升1秒。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Burnice hits an enemy with EX Special Attack: Intense Heat Stirring Method - Double Shot, it triggers an additional special Afterburn effect, dealing 60% of Burnice's ATK as Fire DMG to the target. This effect can trigger once every 0.5s and does not consume Heat. After hitting an enemy with EX Special Attack: Intense Heat Stirring Method - Double Shot, while the move is active, EX Special Attack: Intense Heat Stirring Method - Double Shot, special Afterburn effects, and Burn effects will ignore 25% of the target's Fire RES. When EX Special Attack: Intense Heat Stirring Method - Double Shot's fire blast hits an enemy, if that enemy is Burned, trigger an additional instance of Burn DMG equal to 1,800% of the original DMG. This effect can trigger once every 20s for each target.",
        "zh-CN": "柏妮思的[强化特殊技：灼热摇荡法·双份]命中敌人时，将额外触发特殊的[余烬]效果，对目标造成等同于柏妮思60%攻击力的火属性伤害，0.5秒内最多触发1次，无需消耗[燃点]；发动[强化特殊技：灼热摇荡法·双份]命中敌人后，招式发动期间，[强化特殊技：灼热摇荡法·双份]、特殊的[余烬]效果、[灼烧]效果将无视目标25%火属性伤害抗性；在[强化特殊技：灼热摇荡法·双份]中发动火焰冲击命中处于[灼烧]状态下的敌人时，能够额外结算一次[灼烧]伤害，伤害效果等同于原本的1800%，同一目标20秒内最多触发一次。"
      }
    ]
  }
}