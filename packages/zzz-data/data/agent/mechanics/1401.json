  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "队伍中任意角色对敌人施加物理异常状态后，在异常状态的持续期间，爱丽丝每0.95秒对其额外造成基于该物理异常伤害比例2.5%的伤害，并使物理异常状态下的敌人被触发[紊乱]效果时，每有1秒物理异常状态剩余时间，[紊乱]效果的伤害倍率提升18%，最多提升{0}%；\n爱丽丝攻击命中敌人时，累积[剑仪]，爱丽丝通过属性异常积蓄触发[强击]时，回复10点[剑仪]，[剑仪]的上限为300点，每100点为1格；\n三段蓄力的[普通攻击：星芒圆舞曲]的终结一击命中敌人时，触发特殊的[强击]效果[极性强击]，无视属性积蓄进度造成一次原本[强击]效果{1}%的伤害，并可以与包括物理异常效果在内的其他属性异常效果互相结算[紊乱]；\n爱丽丝触发[强击]时，物理异常积蓄效率提升25%，持续30秒。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在另一名[异常]或[支援]角色时触发：\n队伍中任意角色触发[紊乱]效果时，爱丽丝回复30点[剑仪]；\n若爱丽丝的异常掌控大于140点，每超过1点异常掌控会提升1.6点异常精通；\n进入战场时，爱丽丝获得300点[剑仪]，在勘域模式中此效果180秒内最多触发一次。"
    },
    "cinemaTexts": [
      {
        "en": "When Alice triggers a Polarity Assault, she gains 25 Blade Etiquette. When she triggers Assault against an enemy, the target's DEF is reduced by 20% for 30s.",
        "zh-CN": "爱丽丝触发[极性强击]时，回复25点[剑仪]；爱丽丝触发[强击]时，目标的防御力降低20%，持续30秒。"
      },
      {
        "en": "When Ultimate: Starfall Finale's Finishing Move hits an enemy, it triggers Polarity Assault. All squad members' Assault DMG increases by 15%. Disorder DMG against enemies suffering from Physical Anomaly increases by 15%. Upon entering the battlefield, Alice immediately gains 1,000 Decibels. Triggers once per 180s in Investigation Zone mode.",
        "zh-CN": "[终结技：星芒终章]的终结一击命中敌人时，触发[极性强击]；全队角色造成的[强击]伤害提升15%；物理异常状态下的敌人被结算的[紊乱]伤害提升15%；进入战场时，爱丽丝立刻获得1000点喧响值，在勘域模式中此效果180秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Alice ignores 10% of the target's Physical RES. Enhanced Basic Attack: Celestial Overture accumulates 25% more Physical Anomaly Buildup.",
        "zh-CN": "爱丽丝无视目标10%物理伤害抗性；强化后的[普通攻击：星仪序曲]累积的物理异常积蓄值提升25%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "When Alice uses a third-stage charged Basic Attack: Starshine Waltz or Ultimate: Starfall Finale, she enters the Victory State for 30s. During this time, whenever any squad member lands a hit on a target, Alice will follow up with an extra attack against the target, dealing Physical DMG equal to 3,300% of her Anomaly Proficiency. This effect can trigger once every 1s and is guaranteed to CRIT. This effect can trigger up to 6 times. Gaining the Victory State again refreshes the available trigger count.",
        "zh-CN": "爱丽丝发动三段蓄力的[普通攻击：星芒圆舞曲]或[终结技：星芒终章]时，进入[决胜状态]，持续30秒，在持续期间，队伍中任意角色攻击命中目标后的短时间内，爱丽丝对目标发动1次额外攻击，造成等同于爱丽丝3300%异常精通的物理伤害，必定暴击，该效果1秒内最多触发一次，最多触发6次，再次获得[决胜状态]时刷新可触发次数。"
      }
    ]
  }
