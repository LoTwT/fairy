  "effects": {
    "modifiers": [
      {
        "id": "1251:cinema:6:self-crit-damage",
        "label": "影画6自身暴击伤害",
        "bucket": "modifier",
        "key": "critDamage",
        "value": {
          "kind": "static",
          "value": 1
        },
        "unit": "ratio",
        "target": "self",
        "conditionText": "[普通攻击：醉花月云转]的打断等级大幅提升，招式的暴击伤害额外提升100%"
      }
    ],
    "overrides": []
  },
  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "青衣在[普通攻击：醉花月云转]中发动终结一击命中敌人时，会对敌人施加5层[羁服]，最多叠加20层，每层[羁服]能够使目标的失衡易伤倍率提升4%；在[普通攻击：醉花月云转]中每发动一次突进攻击，终结一击将额外施加1层[羁服]，在发动终结一击时，若触发[极限闪避]，可以直接施加{0}层[羁服]；对普通或精英敌人施加[羁服]时，施加的层数翻倍；目标从失衡状态恢复时，对应[羁服]层数重置。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[强攻]角色或与自身阵营相同的角色时触发：\n[普通攻击]造成的失衡值提升20%；此外，若青衣的冲击力高于120点，每超过1点冲击力会使自身的攻击力提升6点，通过这种方式最多使自身的攻击力提升600点。"
    },
    "cinemaTexts": [
      {
        "en": "When Qingyi enters combat, Flash Connect Voltage is instantly restored to its maximum, and the accumulation rate is increased by 30%. When using her Basic Attack: Enchanted Moonlit Blossoms, if Flash Connect Voltage is at its maximum, the attack will reduce the DEF of the enemy it hits by 15%, and Qingyi's CRIT Rate against that enemy will increase by 20% for 15s.",
        "zh-CN": "青衣进入战场时，立即使[闪络电压]回复至上限，并使其后继累积效率提升30%；发动[普通攻击：醉花月云转]时，若[闪络电压]已累积至上限，则使本次招式命中的敌人防御力降低15%，且自身对该目标的暴击率提升20%，持续15秒。"
      },
      {
        "en": "The Stun DMG Multiplier increase provided by each stack of Subjugation in Core Passive: Eternal Seasons increases to 135% of its original value. When Qingyi's attack hits an enemy and the stacks of Subjugation she applies reaches its maximum stacks, her Daze dealt to the target increases by 15%.",
        "zh-CN": "[核心被动：千秋岁]中每层[羁服]提供的失衡易伤倍率提升效果提升至原本的135%；青衣攻击命中敌人时，若对其施加的[羁服]已叠加至层数上限，则自身对其造成的失衡值提升15%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Upon entering or exiting Flash Connect state, gain a shield equal to 10% of Qingyi's Max HP. If a previous shield is still active when the shield effect refreshes, Qingyi generates 5 Energy. This Energy Generation effect can be triggered once every 10s.",
        "zh-CN": "进入或退出[闪络]状态时，获得等同于青衣10%生命值上限的护盾；护盾效果刷新时，如果上一次获得的护盾仍然存在，则为青衣回复5点能量，能量回复效果10秒内最多触发一次。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "The Interrupt Level of Basic Attack: Enchanted Moonlit Blossoms is greatly increased, and the CRIT DMG is increased by an additional 100%. When Qingyi hits an enemy with her Basic Attack: Enchanted Moonlit Blossoms, the target's Attribute DMG RES is reduced by 20% for 15s.",
        "zh-CN": "[普通攻击：醉花月云转]的打断等级大幅提升，招式的暴击伤害额外提升100%；青衣[普通攻击：醉花月云转]命中敌人时，目标的全属性伤害抗性降低20%，持续15秒。"
      }
    ]
  }
}