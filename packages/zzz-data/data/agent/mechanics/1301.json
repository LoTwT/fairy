  "trace": {
    "sourceRefs": [
      "data/source/xlsx/zh-CN/agent-stat.json",
      "data/source/gachabase/zh-CN/agents.json",
      "data/source/gachabase/en/agents.json",
      "data/source/gachabase/zh-CN/agent-details.json",
      "data/source/gachabase/en/agent-details.json"
    ],
    "coreTexts": {
      "zh-CN": "奥菲丝&「鬼火」的暴击率提升25%，[追加攻击]造成的伤害提升85%；\n奥菲丝&「鬼火」初始获得100点[蓄炎]，最多获得125点；\n奥菲丝&「鬼火」处于后台时，若可释放[特殊技：蚀光一闪]且能量大于等于60点时，改为消耗30点能量自动释放[强化特殊技：灼红旋涡];\n[强化特殊技：蓄热充能]的激光命中敌人时，使全队角色获得[准星聚焦]效果，持续12秒，重复触发时刷新持续时间，代理人拥有[准星聚焦]效果时，攻击力提升280点，当奥菲丝&「鬼火」的初始能量自动回复大于等于1.6点时，超过的部分每拥有0.1点初始能量自动回复，攻击力额外提升20点，初始提升与额外提升总共不超过700点，拥有[准星聚焦]的代理人发动[追加攻击]时，将会使自身的[准星聚焦]效果延长4秒，最多延长20秒；\n[普通攻击：高压火枪]的火刀攻击、[强化特殊技：小心脚下]、[强化特殊技：灼红旋涡]、[强化特殊技：蓄热充能]、[强化特殊技：燥焰迸射]、[连携技：枪管过热]、[终结技：与火共舞]造成的伤害均视为追加攻击伤害，发动上述招式视为发动[追加攻击]。"
    },
    "additionalAbilityTexts": {
      "zh-CN": "队伍中存在[击破]角色或[支援]角色时触发：\n拥有[准星聚焦]的代理人攻击造成的[追加攻击]伤害无视25%防御力。"
    },
    "cinemaTexts": [
      {
        "en": "Orphie & Magus' Special Attack: Corrosive Flash, EX Special Attack: Crimson Vortex, EX Special Attack: Heat Charge, and EX Special Attack: Fiery Eruption ignore 15% of target's Fire RES, and Agents with Zeroed In deal 20% increased DMG.",
        "zh-CN": "奥菲丝&「鬼火」发动[特殊技：蚀光一闪]、[强化特殊技：灼红旋涡]、[强化特殊技：蓄热充能]、[强化特殊技：燥焰迸射]造成的伤害无视15%火属性伤害抗性，且拥有[准星聚焦]的代理人攻击造成的伤害提升20%。"
      },
      {
        "en": "When Orphie & Magus launch an Aftershock, restore 65 Decibels. This effect can trigger once every 4s. After Orphie & Magus use their Ultimate, their ATK increases by 20% for up to 45s.",
        "zh-CN": "奥菲丝&「鬼火」每次发动[追加攻击]时回复65点喧响值，4秒内最多触发一次；奥菲丝&「鬼火」发动[终结技]后，自身的攻击力提升20%，最多持续45秒。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "Initial duration of Zeroed In increases to 16s, and Orphie & Magus's EX Special Attack: Heat Charge and Ultimate: Dance With Fire DMG increases by 40%.",
        "zh-CN": "[准星聚焦]的初始时间提高至16秒，且奥菲丝&「鬼火」发动[强化特殊技：蓄热充能]或[终结技：与火共舞]造成的伤害提高40%。"
      },
      {
        "en": "Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2",
        "zh-CN": "[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技] 技能等级+2"
      },
      {
        "en": "With enough energy, after the fire blade attack of Basic Attack: High-Pressure Flamethrower, press  to immediately follow up with EX Special Attack: Crimson Vortex. When the fire blade attack of Basic Attack: High-Pressure Flamethrower is activated, recover 10 Bottled Heat, and the Interrupt Level during the low firepower phase of EX Special Attack: Heat Charge will also increase. When the laser from EX Special Attack: Heat Charge or Ultimate hits enemies, it deals additional Fire DMG equal to 250% of Orphie & Magus's ATK. This effect can trigger once every 0.5s and is counted as EX Special Attack and Aftershock DMG.",
        "zh-CN": "能量足够时，[普通攻击：高压火枪]的火刀攻击后可点按  直接衔接[强化特殊技：灼红旋涡]；[普通攻击：高压火枪]的火刀攻击发动时，回复10点[蓄炎]，[强化特殊技：蓄热充能]低火力期间打断等级也会提高；[强化特殊技：蓄热充能]或[终结技]的激光命中敌人时，额外对敌人造成等同于奥菲丝&「鬼火」250%攻击力的火属性伤害，该效果每0.5秒最多触发一次，该伤害视为[强化特殊技]和[追加攻击]伤害。"
      }
    ]
  }
