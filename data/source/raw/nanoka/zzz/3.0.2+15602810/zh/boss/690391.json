    "6903901": {
      "name": "基塔布鲁",
      "stage_num": 1,
      "monster_level": 70,
      "layer_buff": {
        "69013003": {
          "title": "",
          "desc": "· 适合<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[异常]</color>特性的代理人挑战。"
        },
        "69013903": {
          "title": "(Test1)TBD",
          "desc": "· 代理人每对首领施加一次异常状态时，会给首领施加一层【易碎】，【侵蚀壁垒】持续期间，还会额外令侵蚀盾<color=#2BAD00>削减最大值的20%</color>，失衡值积累<color=#2BAD00>最大值的20%</color>（<color=#2BAD00>15秒</color>内不会重复触发）；每层【易碎】会令首领受到的<color=#2BAD00>异常伤害提升10%</color>，受到【乱流】伤害额外提升<color=#2BAD00>10%</color>，持续<color=#2BAD00>10秒</color>，最多累计<color=#2BAD00>3层</color>；【侵蚀壁垒】被击破时，首领立刻获得最大层数的【易碎】；首领进入失衡状态时，会移除所有【易碎】，并施加相同层数的【脆弱】状态，每层【脆弱】状态会增加首领<color=#2BAD00>5%异常累积倍率</color>和<color=#2BAD00>15%失衡易伤被倍率</color>。"
        },
        "69013904": {
          "title": "(Test1)TBD",
          "desc": "· 每次成功应对基塔布鲁的连续下砸，可获得<color=#FFAF2C>1000操作得分</color>，成功使用双人弹刀应对最后一段下砸，可获得<color=#FFAF2C>2000操作得分</color>；<color=#FFAF2C>成功击破【侵蚀壁垒】</color>时，可获得<color=#FFAF2C>1000操作得分</color>。最多获得5000操作得分。"
        }
      },
