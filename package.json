{
  "name": "zzz-data-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "prepare": "simple-git-hooks",
    "up": "taze latest -I -f -r",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "release": "bumpp -r && pnpm run data:release"
  },
  "devDependencies": {
    "@ayingott/eslint-config": "^2.0.7",
    "@ayingott/prettier-config": "^2.1.8",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.1",
    "lint-staged": "^16.2.6",
    "pnpm": "^10.20.0",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@ayingott/prettier-config"
}
