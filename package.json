{
  "name": "zzz-data-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "sync": "pnpm --filter zzz-data run sync",
    "sync:xlsx": "pnpm --filter zzz-data run sync:xlsx",
    "sync:gachabase": "pnpm --filter zzz-data run sync:gachabase",
    "sync:buhflipexplode": "pnpm --filter zzz-data run sync:buhflipexplode",
    "sync:mihoyo-wiki": "pnpm --filter zzz-data run sync:mihoyo-wiki",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "up": "taze latest -f -I -r"
  },
  "devDependencies": {
    "@ayingott/eslint-config": "^2.1.0",
    "@ayingott/prettier-config": "^2.1.10",
    "eslint": "^10.0.3",
    "lint-staged": "^16.3.2",
    "pnpm": "^10.31.0",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.10.0"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@ayingott/prettier-config"
}
