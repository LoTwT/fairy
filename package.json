{
  "name": "fairy",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.{json,jsonc,md,yaml,yml,css,scss,html}": "oxfmt --check"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3"
}
